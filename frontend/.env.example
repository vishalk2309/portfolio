# Backend API URL (for development, use localhost; for production, use Render URL)
REACT_APP_BACKEND_URL=http://localhost:8080

# Or for production/deployed backend:
# REACT_APP_BACKEND_URL=https://portfolio-ai-backend-abc123.onrender.com

# Sentry Error Tracking (optional - only required for production error monitoring)
# Get your DSN from: https://sentry.io → Create Project → React
VITE_SENTRY_DSN=https://your-key@sentry.io/your-project-id
